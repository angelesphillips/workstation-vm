function mykeys {
  WORKSTATION_VM_DIR=/home/student/workstation-vm

  if pushd ${WORKSTATION_VM_DIR} &> /dev/null
  then
    ansible-playbook sk.yml --tags ssh_keys,prep_collections --ask-vault-pass
    popd &> /dev/null
  fi
}

function gcl {
  WORKSTATION_VM_DIR=/home/student/workstation-vm

  if pushd ${WORKSTATION_VM_DIR} &> /dev/null
  then
    ansible-playbook configure_git_local.yml --ask-vault-pass
    popd &> /dev/null
  fi
}
