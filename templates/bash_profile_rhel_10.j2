{% if github_keys is defined %}
# Remove personal SSH public and private keys on a new login
{% set private_keys = github_keys | selectattr('type', '==', 'private') %}
{% for PRIVATE_KEY in private_keys %}
[ -f ~/.ssh/{{ PRIVATE_KEY['name'] }} ] && rm -f ~/.ssh/{{ PRIVATE_KEY['name'] }}
{% endfor %}
{% set public_keys = github_keys | selectattr('type', '==', 'public') %}
{% for PUBLIC_KEY in public_keys %}
[ -f ~/.ssh/{{ PUBLIC_KEY['name'] }} ] && rm -f ~/.ssh/{{ PUBLIC_KEY['name'] }}
{% endfor %}

{% endif %}
# Remove TOKEN lines
sed -i '/_TOKEN/d' ~/.bashrc

# Remove container authorization
rm -f /run/user/1000/containers/auth.json

# Display WARNING for new SSH connection
# Notify only for connections that originate from the 172.25.250.0/24 network,
# excluding the machine's own address (172.25.250.9). To avoid a storm of
# windows when an application such as VS Code opens several parallel SSH
# channels, notify only once per source IP while that IP stays connected. If an
# IP disconnects and later reconnects, it is notified again.
CURRENT_GNOME_SESSIONS=$(pgrep -u student gnome-session)
if [ -n "${CURRENT_GNOME_SESSIONS}" ]
then
  # State file tracking source IPs already notified. A single fixed path is
  # shared across all login shells in the desktop session.
  NOTIFIED_IPS_FILE="${XDG_RUNTIME_DIR:-/run/user/1000}/ssh-notified-ips"
  touch "${NOTIFIED_IPS_FILE}"

  # Build the list of qualifying source IPs that are currently connected. The
  # last column of `w --from` is the source host/IP; local sessions (:0, seat0)
  # are excluded.
  CURRENT_REMOTE_IPS="$(w --no-header --from \
    | grep -v -e '^student[[:blank:]]\+:[[:digit:]]' -e '^student[[:blank:]]\+seat0' \
    | grep -o '172\.25\.250\.[[:digit:]]\{1,3\}' \
    | grep -v -x '172.25.250.9' \
    | sort -u)"

  # Prune the state file to IPs that are still connected. An IP that has
  # disconnected drops out, so a later reconnection notifies again.
  if [ -n "${CURRENT_REMOTE_IPS}" ]
  then
    grep -xF -f <(echo "${CURRENT_REMOTE_IPS}") "${NOTIFIED_IPS_FILE}" \
      > "${NOTIFIED_IPS_FILE}.tmp" 2>/dev/null
    mv -f "${NOTIFIED_IPS_FILE}.tmp" "${NOTIFIED_IPS_FILE}"
  else
    : > "${NOTIFIED_IPS_FILE}"
  fi

  # Examine each remote (SSH) session individually.
  w --no-header --from \
    | grep -v -e '^student[[:blank:]]\+:[[:digit:]]' -e '^student[[:blank:]]\+seat0' \
    | while read -r REMOTE_USER REMOTE_TERMINAL REMOTE_IP _REST
  do
    # Keep only sessions that have a dotted-quad source address.
    case "${REMOTE_IP}" in
      [0-9]*.[0-9]*.[0-9]*.[0-9]*) ;;
      *) continue ;;
    esac

    # Restrict to the 172.25.250.0/24 network, excluding the machine itself.
    case "${REMOTE_IP}" in
      172.25.250.9) continue ;;
      172.25.250.*) ;;
      *) continue ;;
    esac

    # Skip source IPs already notified and still connected (the state file was
    # pruned above to currently-connected IPs).
    if grep -qxF "${REMOTE_IP}" "${NOTIFIED_IPS_FILE}"
    then
      continue
    fi
    echo "${REMOTE_IP}" >> "${NOTIFIED_IPS_FILE}"

WARNING_MESSAGE="$(cat <<-END
===============================================================================
The ${REMOTE_USER} user has connected to the ${REMOTE_TERMINAL} terminal from ${REMOTE_IP}.

You can terminate this connection using the following command:
$ sudo pkill -KILL -t ${REMOTE_TERMINAL}
===============================================================================
END
)"
    OLD_DISPLAY=":X"
    for GNOME_PID in ${CURRENT_GNOME_SESSIONS}
    do
      NEW_DISPLAY="$(grep --binary-files=text -o 'DISPLAY=:[[:digit:]]\+' /proc/${GNOME_PID}/environ | sed -e 's/DISPLAY=//')"
      if [ "${NEW_DISPLAY}" != "${OLD_DISPLAY}" ]
      then
        DISPLAY=${NEW_DISPLAY} zenity --info --timeout 300 --title "WARNING: New SSH connection detected" --text "${WARNING_MESSAGE}"
        OLD_DISPLAY=${NEW_DISPLAY}
      fi
    done
  done
fi
