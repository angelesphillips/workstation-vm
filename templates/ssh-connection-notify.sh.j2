#!/bin/bash
# {{ ansible_managed }}
#
# Invoked by PAM (pam_exec.so) for SSH session open and close. Runs as root,
# outside and before the connecting user's shell, so it cannot be bypassed the
# way a .bash_profile hook can.
#
# On session OPEN, for a qualifying connection it:
#   1. removes the personal SSH keys from the user's ~/.ssh directory, before
#      the connecting shell starts, and
#   2. notifies through two layers:
#        - wall       - always-on terminal broadcast; reaches you even when
#                       connected over SSH with no graphical session.
#        - spool file - appended here, watched by a `systemd --user` .path
#                       unit that pops a zenity dialog in the GNOME session.
#
# On session CLOSE, it removes the personal SSH keys again, so keys never
# linger after a session ends.
#
# This script ALWAYS exits 0. It runs in the PAM session phase, so a failure
# here must never block an SSH login.

REMOTE_USER="${PAM_USER:-unknown}"

# Home directory of the connecting user (fall back to {{ the_user }}'s home).
USER_HOME="$(getent passwd "${REMOTE_USER}" | cut -d: -f6)"
[ -n "${USER_HOME}" ] || USER_HOME="/home/{{ the_user }}"

# Remove personal SSH keys. The list is the set of key names managed by the
# github_keys Ansible variable. When github_keys is not defined (for example,
# token-based access), no keys are removed.
remove_personal_keys() {
{% for KEY_NAME in github_keys | default([]) | map(attribute='name') | list %}
  rm -f "${USER_HOME}/.ssh/{{ KEY_NAME }}" 2>/dev/null || true
{% endfor %}
  :
}

# Restrict to connections from the classroom network, excluding the machine's
# own address. Mirrors the policy previously used in .bash_profile.
REMOTE_IP="${PAM_RHOST}"
case "${REMOTE_IP}" in
  172.25.250.9) exit 0 ;;
  172.25.250.*) ;;
  *) exit 0 ;;
esac

case "${PAM_TYPE}" in
  close_session)
    # Keys are also stripped on logout, so nothing lingers after a session.
    remove_personal_keys
    exit 0
    ;;
  open_session) ;;
  *) exit 0 ;;
esac

WHEN="$(date '+%Y-%m-%d %H:%M:%S')"

# Delete keys before the connecting shell can read them.
remove_personal_keys

WARNING_MESSAGE="===============================================================================
New SSH session: user ${REMOTE_USER} from ${REMOTE_IP} at ${WHEN}.

To kill it, click 'Terminate' in the desktop dialog, or run:
  sudo loginctl list-sessions   # find the session for ${REMOTE_IP}
  sudo loginctl terminate-session <session-id>
==============================================================================="

# Layer 1: broadcast to all terminals. Covers the SSH-only, no-GUI case.
# Fail-open: ignore any error so a missing `wall` cannot break login.
echo "${WARNING_MESSAGE}" | wall 2>/dev/null || true

# Layer 2: record the event for the desktop watcher. The spool directory is
# created by systemd-tmpfiles (see ssh-connection-notify tmpfiles config).
SPOOL_DIR="/run/ssh-connection-notify"
SPOOL_FILE="${SPOOL_DIR}/events"
if [ -d "${SPOOL_DIR}" ]
then
  printf '%s\t%s\t%s\n' "${WHEN}" "${REMOTE_USER}" "${REMOTE_IP}" \
    >> "${SPOOL_FILE}" 2>/dev/null || true
fi

exit 0
